@@ -42,6 +42,30 @@
 #include <algorithm>
 
 namespace amd {
+#if defined(WITH_PS5_DEVICE)
+namespace {
+std::atomic_flag commandStatsLock = ATOMIC_FLAG_INIT;
+CommandStats commandStats;
+struct CommandStatsGuard {
+  CommandStatsGuard() noexcept { while (commandStatsLock.test_and_set(std::memory_order_acquire)) {} }
+  ~CommandStatsGuard() { commandStatsLock.clear(std::memory_order_release); }
+};
+}
+CommandStats command_stats() noexcept {
+  CommandStatsGuard guard;
+  return commandStats;
+}
+void Command::accountCreated() noexcept {
+  CommandStatsGuard guard;
+  ++commandStats.created; ++commandStats.live;
+  commandStats.peak = std::max(commandStats.peak, commandStats.live);
+}
+Command::~Command() {
+  CommandStatsGuard guard;
+  ++commandStats.destroyed; --commandStats.live;
+}
+#endif
+
 
