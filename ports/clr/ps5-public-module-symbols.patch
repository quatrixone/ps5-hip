 bool Program::getGlobalFuncFromCodeObj(std::vector<std::string>* func_names) const {
-#if defined(USE_COMGR_LIBRARY)
+#if defined(WITH_PS5_DEVICE)
+  // The AOT loader has already validated and owns these kernels. Compiler
+  // services are neither available nor needed to enumerate this loaded table.
+  if (func_names == nullptr || !isCodeObjectLoaded() || kernels().empty()) return false;
+  std::vector<std::string> names;
+  names.reserve(kernels().size());
+  for (const auto& entry : kernels()) {
+    if (entry.first.empty() || entry.second == nullptr) return false;
