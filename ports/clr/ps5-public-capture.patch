+#if defined(WITH_PS5_DEVICE)
+static hipGraphExecUpdateResult ps5GraphUpdateTypes(
+    const std::vector<hip::GraphNode*>& oldNodes,
+    const std::vector<hip::GraphNode*>& newNodes, hipGraphNode_t* errorNode) {
+  if (oldNodes.size() != newNodes.size()) {
+    *errorNode = nullptr;
+    return hipGraphExecUpdateErrorTopologyChanged;
+  }
+  for (size_t i = 0; i < newNodes.size(); ++i) {
+    auto* oldNode = oldNodes[i];
+    auto* newNode = newNodes[i];
+    if (oldNode->GetType() != newNode->GetType() || typeid(*oldNode) != typeid(*newNode)) {
+      *errorNode = reinterpret_cast<hipGraphNode_t>(newNodes[i]);
+      return hipGraphExecUpdateErrorNodeTypeChanged;
+    }
+    if (newNodes[i]->GetType() == hipGraphNodeTypeGraph) {
+      // ChildGraphNode::SetParams pairs children in insertion order.
+      auto result = ps5GraphUpdateTypes(oldNodes[i]->GetChildGraph()->GetNodes(),
+                                       newNodes[i]->GetChildGraph()->GetNodes(), errorNode);
+      if (result != hipGraphExecUpdateSuccess) {
+        *errorNode = reinterpret_cast<hipGraphNode_t>(newNodes[i]);
+        return result;
+      }
+    }
+  }
+  return hipGraphExecUpdateSuccess;
+}
+#endif
