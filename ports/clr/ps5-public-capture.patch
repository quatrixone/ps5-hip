+#if defined(WITH_PS5_DEVICE)
+static hipError_t ps5GraphParameterStatus(hip::Graph* graph) {
+  for (auto node : graph->GetNodes()) {
+    if (node->GetType() == hipGraphNodeTypeKernel) {
+      auto status = static_cast<hip::GraphKernelNode*>(node)->ParameterStatus();
+      if (status != hipSuccess) return status;
+    } else if (node->GetType() == hipGraphNodeTypeGraph) {
+      auto status = ps5GraphParameterStatus(node->GetChildGraph());
+      if (status != hipSuccess) return status;
+    }
+  }
+  return hipSuccess;
+}
+#endif
