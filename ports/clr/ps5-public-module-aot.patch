 hipError_t FatBinaryInfo::ExtractFatBinary(const std::vector<hip::Device*>& devices) {
+#if defined(WITH_PS5_DEVICE)
+  if (ps5_extract_attempted_) return hipErrorInvalidValue;
+  ps5_extract_attempted_ = true;
+  // Pointer-only images have no caller-supplied extent in this API. Do not
+  // inspect their headers until a bounded memory-image admission path exists.
+  if (fname_.empty()) return hipErrorNotSupported;
+  if (devices.size() != 1 || devices[0] == nullptr || devices[0]->deviceId() < 0 ||
+      static_cast<size_t>(devices[0]->deviceId()) >= fatbin_dev_info_.size()) {
+    return hipErrorInvalidDevice;
+  }
+  const int id = devices[0]->deviceId();
+  if (fatbin_dev_info_[id] != nullptr) return hipErrorInvalidValue;
+  try {
+    std::unique_ptr<std::FILE, decltype(&std::fclose)> file(std::fopen(fname_.c_str(), "rb"), &std::fclose);
+    if (!file) return hipErrorFileNotFound;
+    if (std::fseek(file.get(), 0, SEEK_END) != 0) return hipErrorInvalidImage;
+    const long size = std::ftell(file.get());
+    if (size < 64 || size > 64 * 1024 * 1024 || std::fseek(file.get(), 0, SEEK_SET) != 0) {
+      return hipErrorInvalidImage;
+    }
+    std::vector<unsigned char> bytes(static_cast<size_t>(size));
+    if (std::fread(bytes.data(), 1, bytes.size(), file.get()) != bytes.size() ||
+        std::fgetc(file.get()) != EOF || std::ferror(file.get())) return hipErrorInvalidImage;
+    if (std::fclose(file.release()) != 0) return hipErrorInvalidImage;
+    const auto object = ps5hip::inspect_code_object(bytes.data(), bytes.size());
+    if (object.target != "gfx1013") return hipErrorNoBinaryForGpu;
+    // Programs may borrow this storage; never move/resize it after publication.
+    ps5_image_storage_ = std::move(bytes);
+    image_ = ps5_image_storage_.data();
+    auto info = std::make_unique<FatBinaryDeviceInfo>(image_, ps5_image_storage_.size(), 0);
+    info->program_ = new amd::Program(*devices[0]->asContext());
+    fatbin_dev_info_[id] = info.release();
+    return hipSuccess;
+  } catch (const std::bad_alloc&) {
+    return hipErrorOutOfMemory;
+  } catch (const ps5hip::ObjectError&) {
+    return hipErrorInvalidImage;
+  }
+#else
   if (!HIP_USE_RUNTIME_UNBUNDLER) {
     return ExtractFatBinaryUsingCOMGR(devices);
   }
