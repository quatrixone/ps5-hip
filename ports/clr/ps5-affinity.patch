   if (pthread_setaffinity_fptr != NULL) {
-    if (pthread_setaffinity_fptr((pthread_t)handle, sizeof(NativeCpuSet), &mask.mask_) != 0) {
+    if (!nativeAffinityFits(mask.mask_) ||
+        pthread_setaffinity_fptr((pthread_t)handle, nativeAffinityBytes, &mask.mask_) != 0) {
       fatal("pthread_setaffinity_np() failed");
     }
   }
@@ -516,7 +533,8 @@
 bool Os::setThreadAffinityToMainThread() {
   if (AMD_CPU_AFFINITY) {
     ClPrint(amd::LOG_INFO, amd::LOG_INIT, "Setting Affinity to the main thread's affinity");
-    if (pthread_setaffinity_np(pthread_self(), sizeof(NativeCpuSet), &nativeMask_) != 0) return false;
+    if (!nativeAffinityFits(nativeMask_) ||
+        pthread_setaffinity_np(pthread_self(), nativeAffinityBytes, &nativeMask_) != 0) return false;
   }
   return true;
 }
