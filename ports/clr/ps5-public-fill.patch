+    ps5hip::FillLayout layout{};
+    if (!memory || !memory->asBuffer() || offset > memory->getSize() ||
+        pitchedDevPtr.xsize < extent.width ||
+        !ps5hip::checked_fill_layout(extent.width, extent.height, extent.depth,
+            pitchedDevPtr.pitch, pitchedDevPtr.ysize, memory->getSize() - offset, layout))
+      return hipErrorInvalidValue;
+    amd::FillMemoryCommand* command = nullptr;
+    try {
+      // Reserve before command creation: insertion must not strand a retained buffer.
+      commands.reserve(commands.size() + 1);
+      command = new amd::FillMemoryCommand(*stream, CL_COMMAND_FILL_BUFFER,
+          amd::Command::EventWaitList{}, *memory->asBuffer(), &value, elementSize,
+          amd::Coord3D(offset, 0, 0), amd::Coord3D(extent.width, extent.height, extent.depth),
+          amd::Coord3D(pitchedDevPtr.pitch, pitchedDevPtr.xsize, pitchedDevPtr.ysize));
+    } catch (const std::bad_alloc&) { return hipErrorOutOfMemory; }
+    if (!command) return hipErrorOutOfMemory;
+    if (!command->validatePeerMemory()) { delete command; return hipErrorInvalidValue; }
+    commands.push_back(command);
+    return hipSuccess;
+  }
