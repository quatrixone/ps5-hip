# Replace only the loader translation unit; upstream checkout remains clean.
if(PROJECT_NAME STREQUAL "llama.cpp")
    function(ps5hip_user_loader)
        if(NOT TARGET llama OR NOT EXISTS "${PS5HIP_USER_LOADER}")
            message(FATAL_ERROR "user loader target/source missing")
        endif()
        get_target_property(original llama SOURCES)
        set(replaced)
        set(count 0)
        foreach(item IN LISTS original)
            if(item MATCHES "(^|/)llama-model-loader\\.cpp$")
                list(APPEND replaced "${PS5HIP_USER_LOADER}")
                math(EXPR count "${count} + 1")
            else()
                list(APPEND replaced "${item}")
            endif()
        endforeach()
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "upstream loader target changed")
        endif()
        set_source_files_properties("${PS5HIP_USER_LOADER}" TARGET_DIRECTORY llama
            PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
        set_property(TARGET llama PROPERTY SOURCES "${replaced}")
    endfunction()
    cmake_language(DEFER CALL ps5hip_user_loader)
endif()
