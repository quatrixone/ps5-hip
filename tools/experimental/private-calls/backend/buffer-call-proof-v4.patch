+
 void GCNPassConfig::addPostRegAlloc() {
+  // The module barrier would bypass callee-first IPRA usage collection.
+  if (ProveBufferCalls && TM->Options.EnableIPRA)
+    report_fatal_error("experimental buffer-call proof requires -enable-ipra=false");
   addPass(&SIFixVGPRCopiesID);
   if (getOptLevel() > CodeGenOptLevel::None)
     addPass(&SIOptimizeExecMaskingID);
   TargetPassConfig::addPostRegAlloc();
+  // A ModulePass barrier completes the prior function pipeline for ALL MFs.
+  // Missing bodies remain unknown; ordinary per-function ordering is insufficient.
+  if (ProveBufferCalls)
+    addPass(createAMDGPUProveBufferCallsPass());
 }
 
