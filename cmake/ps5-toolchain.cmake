set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
get_filename_component(PS5HIP_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(PS5HIP_SDK "${PS5HIP_ROOT}/.deps/sdk")
if(NOT EXISTS "${PS5HIP_SDK}/.ps5-sdk-revision")
  message(FATAL_ERROR "Run tools/prepare_sdk.py before the native build")
endif()
file(READ "${PS5HIP_ROOT}/dependencies.json" PS5HIP_LOCK)
string(JSON PS5HIP_EXPECTED_SDK GET "${PS5HIP_LOCK}" sdk revision)
file(STRINGS "${PS5HIP_SDK}/.ps5-sdk-revision" PS5HIP_INSTALLED_SDK)
if(NOT PS5HIP_INSTALLED_SDK STREQUAL PS5HIP_EXPECTED_SDK)
  message(FATAL_ERROR "Native SDK revision does not match dependencies.json")
endif()
find_program(PS5HIP_LLVM_CONFIG NAMES llvm-config-18 REQUIRED)
set(ENV{LLVM_CONFIG} "${PS5HIP_LLVM_CONFIG}")
set(CMAKE_CXX_COMPILER "${PS5HIP_ROOT}/tools/ps5-clangxx")
find_program(CMAKE_AR NAMES llvm-ar-18 REQUIRED)
find_program(CMAKE_RANLIB NAMES llvm-ranlib-18 REQUIRED)
set(CMAKE_FIND_ROOT_PATH "${PS5HIP_SDK}/target")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(BUILD_TESTING OFF CACHE BOOL "Host tests cannot run on the PS5 build host")
