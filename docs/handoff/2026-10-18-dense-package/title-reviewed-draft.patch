+  self.assertIn('PS5HIP_LLM_AUTHENTICATED_MODEL_GATE || PS5HIP_LLM_AUTHENTICATED_DENSE_LAYER',s)
+  self.assertLess(s.index('watchdog_finish();'),s.index('M2_DENSE APP_COMPLETE'))
+  gate=s[s.index('#ifndef PS5HIP_LLM_AUTHENTICATED_DENSE_LAYER'):s.index('#ifndef PS5HIP_LLM_ORIGINAL_MODEL')]
+  self.assertIn('#error dense fixture requires an exclusive synthetic title profile',gate)
